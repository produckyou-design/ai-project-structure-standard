{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-project-structure-standard/schemas/project_config.schema.json",
  "title": "Project Config (.ai-standard)",
  "description": "AI Project Structure Standard 프로젝트 설정 (.ai-standard.json / .ai-standard.yml). 모든 필드는 선택이며, 누락 시 preflight 가 안전한 기본값으로 동작한다.",
  "type": "object",
  "properties": {
    "project_name": { "type": "string" },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "protected_branches": { "type": "array", "items": { "type": "string" } },
    "verify_commands": { "type": "array", "items": { "type": "string" } },
    "test_command": { "type": "string" },
    "forbidden_patterns": { "type": "array", "items": { "type": "string" } },
    "allow_exceptions": { "type": "array", "items": { "type": "string" } },
    "allowed_domains": { "type": "array", "items": { "type": "string" } },
    "required_documents": { "type": "array", "items": { "type": "string" } },
    "protected_files": { "type": "array", "items": { "type": "string" } },
    "secret_files": { "type": "array", "items": { "type": "string" } },
    "release_enabled": { "type": "boolean" },
    "require_human_approval": { "type": "boolean" },
    "require_rollback": { "type": "boolean" }
  },
  "additionalProperties": true
}
